---
import ProjectCard from '../components/ProjectCard.astro';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const content = await getCollection('content');

const columnCount = 3;
const columnSize = Math.ceil(content.length / columnCount);

const columns = Array.from({ length: columnCount }, (_, i) =>
	content.slice(i * columnSize, (i + 1) * columnSize)
);

const description = "A curious corner of the internet where I conduct highly unofficial experiments in code, design, and whatever shiny new technology caught my attention. Results may vary, side effects include learning"
---

<Layout title="Andka labs" description={description}>
	<div class="px-7 py-10 of-x-hidden">
		<article class="w-full h-full grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-4">
			{columns.map((col, colIndex) => (
				<div class="flex flex-col gap-4">
					{col.map(({ data, id }, itemIndex) => (
						<ProjectCard
							date={data.date}
							title={data.title}
							description={data.description}
							imageUrl={data.imageUrl}
							url={id}
							github={data.github}
							index={colIndex * columnSize + itemIndex}
						/>
					))}
				</div>
			))}
		</article>
	</div>
</Layout>
